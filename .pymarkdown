// pymarkdownlnt's configuration (JSON5), for the pages and the README.
{
  extensions: {
    // Otherwise, the front matter reads as headings.
    "front-matter": { enabled: true },
  },
  plugins: {
    // A paragraph is one line.
    md013: { enabled: false },
    // The page's title is in its front matter.
    md041: { enabled: false },
    // Notion's bold paragraphs.
    md036: { enabled: false },
    // A line break is a newline, not two trailing spaces.
    md009: { br_spaces: 0 },
    // <br> is a line break in a table cell, or an empty line in Notion's text.
    md033: { allowed_elements: "br" },
    // Headings are at Notion's levels: the title and "#" headings are <h1>, and some levels are skipped (see #17).
    md001: { enabled: false },
    md025: { enabled: false },
    md049: { style: "asterisk" },
  },
}
