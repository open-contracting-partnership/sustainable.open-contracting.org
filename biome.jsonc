{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      // Jekyll's templates and includes, whose Liquid Biome can't parse.
      "!**/*.html",
      // Super.so's stylesheets, which are copied as is.
      "!assets/css/next.css",
      "!assets/css/notion.css",
      "!assets/css/static.css",
      "!assets/css/super.css",
      "!assets/css/theme-*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 119
  }
}
